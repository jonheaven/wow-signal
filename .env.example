# Optional. Defaults to embedded PGLite (auth sessions only).
# DATABASE_URL=postgres://user:pass@localhost:5432/wow_signal

# Product backend — command.dog (wall / prepare / Grok). Index is dogex.
# COMMAND_DOG_API_URL=http://127.0.0.1:3000
# VITE_COMMAND_DOG_API_URL=http://127.0.0.1:3000

# Auth — production on wow.dogenals.com MUST use your own Google + X apps.
# The baked grok_preview client only allows *.grok-sandbox.com (Invalid redirect URI).
# BETTER_AUTH_URL=https://wow.dogenals.com
# BETTER_AUTH_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client
# Authorized redirect URI (exact):
#   https://wow.dogenals.com/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# X Developer Portal → your app → User authentication settings
# Callback URI (exact):
#   https://wow.dogenals.com/api/auth/callback/twitter
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Optional. Grok App Builder deployer injects these. Do NOT use grok_preview
# on a custom domain.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# PORT=3083
