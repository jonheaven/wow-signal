# Optional. Defaults to embedded PGLite (auth sessions only).
# DATABASE_URL=postgres://user:pass@localhost:5432/wow_signal

# Product backend — command.dog (wall / prepare / Grok). Index is dogex.
# COMMAND_DOG_API_URL=http://127.0.0.1:3000
# VITE_COMMAND_DOG_API_URL=http://127.0.0.1:3000

# Auth — production on wow.dogenals.com MUST use your own Google + X apps.
# The baked grok_preview client only allows *.grok-sandbox.com (Invalid redirect URI).
# `dogenals launch` injects these from command.dog/api/.env into this process.
# BETTER_AUTH_URL=https://wow.dogenals.com
# BETTER_AUTH_SECRET=

# Google: https://console.cloud.google.com/apis/credentials  (OAuth client ID, Web)
# Redirect URIs:
#   https://wow.dogenals.com/api/auth/callback/google
#   http://127.0.0.1:3083/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# X (2026): OAuth 2.0 Client ID + Client Secret — NOT X_API_KEY / access-token.
# Portal: https://developer.x.com/en/portal/dashboard → User authentication settings.
# Callback URIs (Better Auth still names the provider `twitter`):
#   https://wow.dogenals.com/api/auth/callback/twitter
#   http://127.0.0.1:3083/api/auth/callback/twitter
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Optional. Grok App Builder deployer injects these. Do NOT use grok_preview
# on a custom domain.
# GROK_AUTH_ISSUER=https://auth.grok.me
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=

# `dogenals launch` sets PORT=3083 and BETTER_AUTH_URL=https://wow.dogenals.com
# PORT=3083
